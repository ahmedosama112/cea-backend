# ── Database ──
DATABASE_URL="mysql://cea_user:changeme@localhost:3306/cea"

# ── Server ──
PORT=4000
NODE_ENV=development
# قائمة أصول مفصولة بفواصل مسموح لها بالوصول (أصل التطبيق/الواجهة الأمامية)
CORS_ORIGIN=http://localhost:5173

# ── Auth ──
# غيّرهم بقيم عشوائية طويلة (32+ حرف) قبل أي بيئة production — لا تستخدم القيم الافتراضية أبدًا
JWT_ACCESS_SECRET=change-this-access-secret-before-production
JWT_REFRESH_SECRET=change-this-refresh-secret-before-production
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# ── Files ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# ── Rate limiting ──
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# قاعدة الاختبارات (منفصلة — بتتمسح مع كل npm test)
TEST_DATABASE_URL=

# قاعدة اختبارات e2e (npm run test:e2e) — منفصلة عن الاتنين اللي فوق، بتتمسح بالكامل مع كل تشغيل
E2E_DATABASE_URL=
# بورت السيرفر أثناء e2e (افتراضي 4100 عشان مايتخانقش مع npm run dev على 4000)
E2E_PORT=

# ── Google Sheet (Apps Script Web App) — اختياري: لو فاضيين، الربط متوقف والتسليم المحلي شغال عادي ──
# المشروع/الموقع الأول (الافتراضي لكل المستخدمين)
GOOGLE_WEBAPP_URL=
GOOGLE_WEBAPP_SECRET=
# المشروع/الموقع الثاني — شيت وApps Script منفصلين بمديرين مختلفين.
# المهندس اللي الأدمن محدد له "المشروع الثاني" تسليماته بتروح هنا. لو فاضيين، تسليماته محلية فقط.
GOOGLE_WEBAPP_URL_2=
GOOGLE_WEBAPP_SECRET_2=

# نسخة احتياطية محلية (npm run backup:local) — رابط قاعدة الإنتاج العام من Railway
# (MYSQL_PUBLIC_URL مش الداخلي). اختياري: من غيره السكربت بيقف برسالة واضحة.
PROD_DATABASE_URL=
