@@ -0,0 +1,44 @@
+import crypto from 'crypto';
+import { spawnSync } from 'child_process';
+import bcrypt from 'bcryptjs';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { prisma, resetDb } from './helpers';
+
+function runSeed(password: string) {
+  return spawnSync(process.execPath, ['-r', 'ts-node/register/transpile-only', 'prisma/seed.ts'], {
+    cwd: process.cwd(),
+    encoding: 'utf8',
+    timeout: 25000,
+    env: { ...process.env, SEED_ADMIN_EMAIL: 'seed-security@test.com', SEED_ADMIN_PASSWORD: password },
+  });
+}
+
+describe('Secure first-admin seeding', () => {
+  beforeAll(async () => { await resetDb(); });
+  afterAll(async () => { await prisma.$disconnect(); });
+
+  it('requires a supplied password instead of generating and printing one', async () => {
+    const result = runSeed('');
+    expect(result.status).toBe(1);
+    expect(result.stderr).toContain('SEED_ADMIN_PASSWORD');
+    expect(await prisma.user.count()).toBe(0);
+  });
+
+  it('rejects an overlong password without printing its value', async () => {
+    const password = crypto.randomBytes(40).toString('hex');
+    const result = runSeed(password);
+    expect(result.status).toBe(1);
+    expect(result.stdout + result.stderr).not.toContain(password);
+    expect(await prisma.user.count()).toBe(0);
+  });
+
+  it('creates an admin with a valid supplied password without echoing it', async () => {
+    const password = crypto.randomBytes(20).toString('hex');
+    const result = runSeed(password);
+    expect(result.status).toBe(0);
+    expect(result.stdout + result.stderr).not.toContain(password);
+    const admin = await prisma.user.findUniqueOrThrow({ where: { email: 'seed-security@test.com' } });
+    expect(admin.role).toBe('ADMIN');
+    expect(await bcrypt.compare(password, admin.passwordHash)).toBe(true);
+  });
+});
diff --git a/src/utils/errorDiagnostics.ts b/src/utils/errorDiagnostics.ts
new file mode 100644
index 0000000..f6e7493
--- /dev/null
+++ b/src/utils/errorDiagnostics.ts
@@ -0,0 +1,43 @@
+import { Request } from 'express';
+
+// نحتفظ بالرسالة والـstack للتشخيص دون تسلسل كائن الخطأ أو جسم الطلب.
+// نحجب بيانات الاعتماد المعروفة من البيئة ومن حقول الطلب الحساسة.
+export function errorDiagnostics(err: unknown, req: Request) {
+  if (!(err instanceof Error)) return { name: 'UnknownError', kind: typeof err };
+
+  const secrets = new Set<string>();
+  function add(value: unknown) {
+    if (typeof value === 'string' && value.length >= 8) secrets.add(value);
+  }
+  for (const [name, value] of Object.entries(process.env)) {
+    if (/SECRET|TOKEN|PASSWORD|DATABASE_URL|API_KEY/i.test(name)) add(value);
+    if (/DATABASE_URL/i.test(name) && value) {
+      try {
+        const pw = new URL(value).password;
+        add(pw);
+        add(decodeURIComponent(pw));
+      } catch { /* ليس URL صالحًا */ }
+    }
+  }
+  const authorization = req.get('authorization');
+  add(authorization);
+  if (authorization?.startsWith('Bearer ')) add(authorization.slice(7));
+
+  const seen = new WeakSet<object>();
+  const pending: unknown[] = [req.body, req.query, (err as Error & { body?: unknown }).body];
+  while (pending.length) {
+    const value = pending.pop();
+    if (!value || typeof value !== 'object' || seen.has(value)) continue;
+    seen.add(value);
+    for (const [key, entry] of Object.entries(value)) {
+      if (/password|token|secret|authorization|api.?key/i.test(key)) add(entry);
+      if (entry && typeof entry === 'object') pending.push(entry);
+    }
+  }
+
+  const values = [...secrets].sort((a, b) => b.length - a.length);
+  function redact(text: string) {
+    return values.reduce((safe, secret) => safe.split(secret).join('[REDACTED]'), text);
+  }
+  return { name: redact(err.name), message: redact(err.message), stack: redact(err.stack || `${err.name}: ${err.message}`) };
+}
